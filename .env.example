# Copy to .env (gitignored) and fill in. Shared by Mark's model/ scripts and Harry's backend.
# C3: one OpenAI-compatible URL for all Gemma models (infra/model_proxy.py on the Verda box)
MODEL_BASE_URL=http://<verda-box-ip>:8000/v1
MODEL_API_KEY=<openssl rand -hex 24>

# $/h of the box serving the models, used for cost per 1,000 questions. Read it off the Verda dashboard.
MODEL_USD_PER_HOUR=2.00

# Dataset root (contains questions.jsonl and data/). Default: datasets/junction-dataset
# JUNCTION_DATA=datasets/junction-dataset

# Frontend (Vite): Harry's API. Leave empty to use the built-in mock.
VITE_API_BASE=

# Verda API (only for infra/self_delete.py on the box)
# VERDA_CLIENT_ID=
# VERDA_CLIENT_SECRET=
