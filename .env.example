# Copy to .env (gitignored) and fill in. Shared by Mark's model/ scripts and Harry's backend.
# Format: KEY=value, no spaces around "=", no comment on a value line (.githooks/pre-commit checks this).
# C3: one OpenAI-compatible URL for all Gemma models (infra/model_proxy.py on the Verda box)
MODEL_BASE_URL=http://<verda-box-ip>:8000/v1
# make one with: openssl rand -hex 24
MODEL_API_KEY=

# Optional outage/recovery timing (seconds). Auto returns geometry promptly if Gemma stalls.
# LEARGAS_GEMMA_CHECK_TIMEOUT=3
# LEARGAS_GEMMA_CHECK_INTERVAL=10
# LEARGAS_GEMMA_COMPARE_WAIT=1
# LEARGAS_GEMMA_TIMEOUT=15

# $/h of the box serving the models, used for cost per 1,000 questions. Read it off the Verda dashboard.
MODEL_USD_PER_HOUR=2.00

# Dataset root (contains questions.jsonl and data/). Default: datasets/junction-dataset
# JUNCTION_DATA=datasets/junction-dataset

# Frontend (Vite): Harry's API. Leave empty to use the built-in mock.
VITE_API_BASE=

# ElevenLabs voice (backend only; the key never reaches the browser). Leave empty to hide the mic.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1

# Verda API (only for infra/self_delete.py on the box)
# VERDA_CLIENT_ID=
# VERDA_CLIENT_SECRET=
