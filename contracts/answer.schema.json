{
  "$defs": {
    "BBoxEvidence": {
      "properties": {
        "kind": {
          "const": "bbox",
          "default": "bbox",
          "title": "Kind",
          "type": "string"
        },
        "bbox": {
          "description": "[x0, y0, x1, y1]",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "BBoxEvidence",
      "type": "object"
    },
    "Evidence": {
      "description": "One highlighted item on the drawing \u2014 e.g. one counted window, or one room polygon.",
      "properties": {
        "shape": {
          "discriminator": {
            "mapping": {
              "bbox": "#/$defs/BBoxEvidence",
              "point": "#/$defs/PointEvidence",
              "polygon": "#/$defs/PolygonEvidence"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PolygonEvidence"
            },
            {
              "$ref": "#/$defs/BBoxEvidence"
            },
            {
              "$ref": "#/$defs/PointEvidence"
            }
          ],
          "title": "Shape"
        },
        "page": {
          "default": 0,
          "description": "0-based page index for multi-page PDFs; 0 for images",
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. \"window\", \"Living Room 27.7 m\u00b2\"",
          "title": "Label"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "This item's contribution, e.g. a room's m\u00b2",
          "title": "Value"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "shape"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "OpeningItem": {
      "description": "One counted door or window: a row of the reviewable inventory and a numbered marker.",
      "properties": {
        "number": {
          "description": "1-based; matches the marker on the sheet",
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "id": {
          "description": "DXF handle of the (first) leaf, or IFC GlobalId",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "door",
            "window"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The occurrence's own number/tag, if the model has one",
          "title": "Mark"
        },
        "type_mark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Mark"
        },
        "type_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Name"
        },
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "location": {
          "description": "Adjoining rooms/spaces, nearest first",
          "items": {
            "type": "string"
          },
          "title": "Location",
          "type": "array"
        },
        "leaves": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Door leaves in this assembly; a double door is 1 item, 2 leaves",
          "title": "Leaves"
        },
        "width_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width M"
        },
        "duplicates": {
          "description": "Ids of identical symbols drawn on top, not counted",
          "items": {
            "type": "string"
          },
          "title": "Duplicates",
          "type": "array"
        },
        "evidence_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Index into `evidence` of this item's marker",
          "title": "Evidence Index"
        }
      },
      "required": [
        "number",
        "id",
        "kind"
      ],
      "title": "OpeningItem",
      "type": "object"
    },
    "PointEvidence": {
      "properties": {
        "kind": {
          "const": "point",
          "default": "point",
          "title": "Kind",
          "type": "string"
        },
        "point": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Point",
          "type": "array"
        }
      },
      "required": [
        "point"
      ],
      "title": "PointEvidence",
      "type": "object"
    },
    "PolygonEvidence": {
      "properties": {
        "kind": {
          "const": "polygon",
          "default": "polygon",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Points",
          "type": "array"
        },
        "holes": {
          "description": "Interior rings excluded from the measured area",
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Holes",
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "title": "PolygonEvidence",
      "type": "object"
    },
    "QuestionType": {
      "enum": [
        "count",
        "area",
        "length",
        "volume",
        "text",
        "other"
      ],
      "title": "QuestionType",
      "type": "string"
    },
    "Region": {
      "description": "A non-empty selection in the same normalized coordinates as sheet evidence.",
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "page": {
          "const": 0,
          "default": 0,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "Region",
      "type": "object"
    },
    "RoomArea": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "m2",
          "default": "m2",
          "title": "Unit",
          "type": "string"
        },
        "method": {
          "enum": [
            "printed",
            "geometry",
            "quantity"
          ],
          "title": "Method",
          "type": "string"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "evidence_indices": {
          "items": {
            "type": "integer"
          },
          "title": "Evidence Indices",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "method"
      ],
      "title": "RoomArea",
      "type": "object"
    },
    "SlabArea": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "mark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mark"
        },
        "slab_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slab Type"
        },
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "m2",
          "default": "m2",
          "title": "Unit",
          "type": "string"
        },
        "method": {
          "enum": [
            "geometry",
            "quantity"
          ],
          "title": "Method",
          "type": "string"
        },
        "thickness_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thickness Mm"
        },
        "reinforcement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reinforcement"
        },
        "specification_status": {
          "default": "unknown",
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Specification Status",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/SpecificationReference"
          },
          "title": "References",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "evidence_indices": {
          "items": {
            "type": "integer"
          },
          "title": "Evidence Indices",
          "type": "array"
        }
      },
      "required": [
        "id",
        "value",
        "method"
      ],
      "title": "SlabArea",
      "type": "object"
    },
    "SlabGroup": {
      "properties": {
        "thickness_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thickness Mm"
        },
        "reinforcement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reinforcement"
        },
        "specification_status": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Specification Status",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "m2",
          "default": "m2",
          "title": "Unit",
          "type": "string"
        },
        "slab_ids": {
          "items": {
            "type": "string"
          },
          "title": "Slab Ids",
          "type": "array"
        }
      },
      "required": [
        "specification_status",
        "value",
        "slab_ids"
      ],
      "title": "SlabGroup",
      "type": "object"
    },
    "Source": {
      "enum": [
        "geometry_dxf",
        "geometry_ifc",
        "gemma_ft",
        "gemma_base",
        "sheet_reader",
        "mock"
      ],
      "title": "Source",
      "type": "string"
    },
    "SourceAnswer": {
      "description": "What an individual source said, kept so the UI can show agreement/disagreement.",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "answer": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answer"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "source",
        "answer",
        "confidence"
      ],
      "title": "SourceAnswer",
      "type": "object"
    },
    "SpecificationReference": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "page": {
          "default": 0,
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "path",
        "label"
      ],
      "title": "SpecificationReference",
      "type": "object"
    },
    "Status": {
      "enum": [
        "verified",
        "partial",
        "disagreement",
        "cannot_verify"
      ],
      "title": "Status",
      "type": "string"
    },
    "Unit": {
      "enum": [
        "count",
        "m",
        "m2",
        "m3",
        "ft",
        "ft2",
        "ft3"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "properties": {
    "openings": {
      "description": "Door/window inventory behind a count",
      "items": {
        "$ref": "#/$defs/OpeningItem"
      },
      "title": "Openings",
      "type": "array"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "region": {
      "anyOf": [
        {
          "$ref": "#/$defs/Region"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "area_mode": {
      "default": "whole_rooms",
      "enum": [
        "whole_rooms",
        "intersection"
      ],
      "title": "Area Mode",
      "type": "string"
    },
    "room_areas": {
      "items": {
        "$ref": "#/$defs/RoomArea"
      },
      "title": "Room Areas",
      "type": "array"
    },
    "slab_areas": {
      "items": {
        "$ref": "#/$defs/SlabArea"
      },
      "title": "Slab Areas",
      "type": "array"
    },
    "slab_groups": {
      "items": {
        "$ref": "#/$defs/SlabGroup"
      },
      "title": "Slab Groups",
      "type": "array"
    },
    "answer": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "null when status is cannot_verify",
      "title": "Answer"
    },
    "unit": {
      "anyOf": [
        {
          "$ref": "#/$defs/Unit"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "null for text answers"
    },
    "type": {
      "$ref": "#/$defs/QuestionType"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "source": {
      "$ref": "#/$defs/Source",
      "description": "Source whose value is reported in `answer`"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Short human-readable reasoning / why it can't verify",
      "title": "Explanation"
    },
    "sources": {
      "description": "Per-source answers when the router ran more than one",
      "items": {
        "$ref": "#/$defs/SourceAnswer"
      },
      "title": "Sources",
      "type": "array"
    },
    "latency_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    }
  },
  "required": [
    "path",
    "question",
    "answer",
    "type",
    "status",
    "confidence",
    "source"
  ],
  "title": "Answer",
  "type": "object"
}
