{
  "$defs": {
    "QuestionType": {
      "enum": [
        "count",
        "area",
        "length",
        "volume",
        "text",
        "other"
      ],
      "title": "QuestionType",
      "type": "string"
    },
    "Region": {
      "description": "A non-empty selection in the same normalized coordinates as sheet evidence.",
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "page": {
          "const": 0,
          "default": 0,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "Region",
      "type": "object"
    }
  },
  "properties": {
    "path": {
      "description": "Dataset path, e.g. \"data/swiss_dwellings/site3387_bldg5238_floor23498.pdf\"",
      "title": "Path",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "type": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuestionType"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Hint if known; otherwise inferred"
    },
    "engine": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "geometry",
            "gemma_ft",
            "gemma_base"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "auto",
      "title": "Engine"
    },
    "region": {
      "anyOf": [
        {
          "$ref": "#/$defs/Region"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "path",
    "question"
  ],
  "title": "AskRequest",
  "type": "object"
}
